{
  "name": "nomad/finance",
  "description": "Personal finance register for a digital nomad",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-bcmath": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "php-di/php-di": "^7.0",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.15"
  },
  "require-dev": {
    "php-webdriver/webdriver": "^1.15",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
    "scripts": {
        "start": "php -S 127.0.0.1:8080 -t public public/index.php",
        "test": "phpunit --testsuite unit",
        "test:browser": "phpunit --testsuite browser",
        "demo:reset": "php bin/reset-demo.php"
    },
  "config": {
    "sort-packages": true
  }
}
